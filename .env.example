# 复制为 .env.local 后按需填写。.env.local 已在 .gitignore 中，不会被提交。

# ===== 大模型（必填，否则自动降级为本地规则模拟） =====
# 兼容 OpenAI 协议的服务均可：DeepSeek / 通义千问 DashScope / 私有部署
API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=v4flash
VISION_MODEL=v4flash
# 设为 true 可强制使用内置规则模拟，便于无网络环境下开发与演示
MOCK_LLM=false

# ===== 向量模型（可选） =====
# 留空则从 HuggingFace 在线拉取 BAAI/bge-m3
# 若要离线加载，填本地目录的绝对路径并把 USE_LOCAL_BGE 设为 true
USE_LOCAL_BGE=false
BGE_M3_MODEL_PATH=

# ===== Milvus 向量库（可选，不可用时自动降级为本地索引 + BM25） =====
USE_MILVUS=true
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=gift_knowledge

# ===== Redis 对话缓存（可选，缺省则跳过该层） =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=2
REDIS_TTL_SECONDS=86400

# ===== MySQL FAQ 库（可选，缺省则跳过该层） =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=gift_desk
FAQ_BM25_CONFIDENCE=0.78
FAQ_BM25_MIN_SCORE=5.0

# ===== 跨域白名单（逗号分隔） =====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== 应用信息 =====
APP_NAME=海贸工作台
COMPANY_NAME=海贸礼品中国分部
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
