# ===== DeepSeek（优先系统环境变量 DP_Apikey）=====
# 也可填 LLM_API_KEY；模型别名 v4flash → deepseek-flash
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=v4flash
VISION_MODEL=v4flash
MOCK_LLM=false

# ===== 本地 BGE-M3 =====
USE_LOCAL_BGE=true
BGE_M3_MODEL_PATH=F:\eduagent\code\models\embedding\bge-m3

# ===== Redis / MySQL 对话助手 =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=2
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=gift
MYSQL_PASSWORD=<REDACTED>
MYSQL_DATABASE=gift_desk
FAQ_BM25_CONFIDENCE=0.78
FAQ_BM25_MIN_SCORE=5.0

APP_NAME=海贸工作台
COMPANY_NAME=宁波长海机电有限公司
API_PORT=8000
